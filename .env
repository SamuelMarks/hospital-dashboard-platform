# ==============================================================================
# Hospital Dashboard Platform (Pulse Query) - Environment Configuration (.env)
# ==============================================================================

# --- Service Account & Host Filesystem Paths ---
REMOTE_USER=azureuser
REMOTE_GROUP=azureuser
REMOTE_HOME=/home/azureuser
REMOTE_DEST=hospital-dashboard-platform
REMOTE_APP_DIR=/home/azureuser/hospital-dashboard-platform
SERVICE_USER=azureuser
SERVICE_GROUP=azureuser
SERVICE_HOME=/home/azureuser
PULSE_API_PORT=8000
PULSE_WEB_PORT=4200
DATA_MOUNT_DIR=/mnt/data
DUCKDB_PATH=/mnt/data/hospital_analytics.duckdb
CHECKPOINTS_DIR=/mnt/data/checkpoints
FRONTEND_STATIC_TARGET=/home/azureuser/hospital-dashboard-platform/pulse-query-ng-web/dist/pulse-query-ng-web/browser
UV_BIN=uv
SERVICE_EXTRA_PATH=/home/azureuser/.libscript/nodejs/22/bin:/home/azureuser/.libscript/nodejs/20/bin:/home/azureuser/.volta/bin:/home/azureuser/.local/bin:/root/.libscript/nodejs/22/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --- Host OS, Init System & Diagnostic Commands ---
HOST_OS=linux
VM_OS_IMAGE=ubuntu-24.04
AZURE_VM_IMAGE=Ubuntu2404
AWS_VM_IMAGE=ami-ubuntu-lts
GCP_VM_IMAGE=ubuntu-2404-lts
INIT_SYSTEM=systemd
BACKEND_DIAG_LOG_CMD="journalctl -u pulse-query-backend -n 30 --no-pager"
FRONTEND_DIAG_LOG_CMD="journalctl -u nginx -n 30 --no-pager"
BACKUP_PATHS="/var/lib/postgresql/data /mnt/data /etc/letsencrypt"

# --- Cloud Provider & Provisioning Defaults ---
CLOUD_PROVIDER=azure
DEFAULT_CLOUD_PROVIDER=azure
SUPPORTED_CLOUD_PROVIDERS=azure,aws,gcp
CLOUD_CLI_BIN=az
CLOUD_CLI_DISPLAY_NAME=Azure
CLOUD_CLI_AUTH_ARGS="account show"
CLOUD_CLI_LOGIN_HINT="az login"
NODE_NAME=test-pulse-query-node
RG_NAME=rg-analytics-test11
DEFAULT_RG_NAME=rg-analytics-test11
PROD_RG_NAME=rg-analytics-prod
DEFAULT_CLOUD_LOCATION=eastus
DEFAULT_AWS_LOCATION=us-east-1
DEFAULT_GCP_LOCATION=us-central1-a

# --- Database & LLM Runtime Configuration ---
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=pulse_query_db
OLLAMA_HOST=http://127.0.0.1:11434/v1
OLLAMA_MODELS="gemma4:26b|Gemma4 (26b), gemma2:27b|Gemma2 (27b), gemma:latest|Gemma (7b), gemma:2b|Gemma (2b)"
