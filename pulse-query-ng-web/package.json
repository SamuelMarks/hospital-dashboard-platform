{
  "name": "pulse-query-ng-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "docs": "compodoc -p tsconfig.doc.json -d docs",
    "docs:coverage": "compodoc -p tsconfig.doc.json --coverageTest 100 --coverageMinimumPerFile 100 --coverageTestShowOnlyFailed && NODE_PATH=node_modules npx tsx ../scripts/verify_docs.ts",
    "serve:ssr:pulse-query-ng-web": "node dist/pulse-query-ng-web/server/server.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@material/material-color-utilities": "^0.4.0",
    "codemirror": "^6.0.2",
    "express": "^5.3.0",
    "prettier": "^3.9.10",
    "rxjs": "~7.8.2",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/browser-preview": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "listr2": "10.2.1"
  }
}
