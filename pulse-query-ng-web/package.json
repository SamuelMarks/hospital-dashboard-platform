{
  "name": "pulse-query-ng-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "docs": "compodoc -p tsconfig.doc.json -d docs",
    "docs:coverage": "compodoc -p tsconfig.doc.json --coverageTest 100 --coverageMinimumPerFile 100 --coverageTestShowOnlyFailed",
    "serve:ssr:pulse-query-ng-web": "node dist/pulse-query-ng-web/server/server.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.11",
    "@material/material-color-utilities": "^0.4.0",
    "codemirror": "^6.0.2",
    "express": "^5.1.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "ts-morph": "^27.0.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@axe-core/playwright": "^4.11.0",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/browser-preview": "^4.1.9",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^27.1.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
