{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": "..",
    "baseUrl": ".",
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@material/material-color-utilities": ["src/test-mocks/material-color-utilities.ts"],
      "@material/material-color-utilities/*": ["src/test-mocks/material-color-utilities.ts"],
      "typescript": ["node_modules/typescript"]
    },
    "types": ["vitest/globals", "node", "@angular/localize"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "src/test-mocks/**/*.ts",
    "src/test-utils/**/*.ts",
    "e2e/**/*.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
