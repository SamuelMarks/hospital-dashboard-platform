{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "baseUrl": ".",
    "paths": {
      "@material/material-color-utilities": ["src/test-mocks/material-color-utilities.ts"],
      "@material/material-color-utilities/*": ["src/test-mocks/material-color-utilities.ts"]
    },
    "types": ["vitest/globals", "node", "@angular/localize"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/test-setup.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
